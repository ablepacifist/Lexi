# =============================================================================
# Lexi ENV TEMPLATE — copy to `.env` and fill in (optional: Lexi runs fine
# with none of this set). Lexi is a module of the full-back-end-server
# monorepo's ONE destination registry — same key names as the root
# `.env.example`; see that file for the full registry and secrets policy.
#
# LAYERING for the destination fields below (lowest -> highest priority):
#   1. dataclass defaults in lexi/config.py / config.toml (engine settings
#      only — it carries no destinations)
#   2. this file, copied to Lexi/.env (git-ignored) — so Lexi runs standalone
#      when cloned by itself
#   3. the monorepo root `.env` — found via $MASTER_ENV_FILE, else by walking
#      up from Lexi/ for a `.env` that contains a `LAN_HOST=` line; a lone
#      Lexi checkout with no such ancestor silently stays on layers 1-2
#   4. real process environment variables (highest)
# A missing file at any layer is silently fine.
#
# Format: KEY=value, one per line, no inline comments; optional surrounding
# quotes are stripped.
# =============================================================================

# ----- Bind address (lexi/server.py argparse defaults for `python -m lexi.server`)
LEXI_HOST=127.0.0.1
LEXI_PORT=8765

# ----- Lexicon (identity lookups + the media-library player) -----------------
# identity.lexicon_base_url is composed as http://127.0.0.1:${LEXICON_PORT}.
LEXICON_PORT=36568
# Cloudflare tunnel fallback for Lexicon (identity.lexicon_fallback_url), used
# when the loopback/LAN path is unreachable. Blank = no fallback.
PUBLIC_LEXICON_URL=

# ----- Obrenna's brain (on alison) --------------------------------------------
# brain.lan_base_url is composed as http://${ALISON_LAN_IP}:${BRAIN_LAN_PORT};
# BOTH must be set for the LAN path to be used. Leave ALISON_LAN_IP blank on a
# standalone checkout with no alison on the LAN — Lexi then uses the tunnel
# only. Never invent a LAN address here.
ALISON_LAN_IP=
BRAIN_LAN_PORT=9080
# Cloudflare tunnel for the brain (brain.tunnel_base_url). The dataclass
# default already points at the real tunnel, so this is only needed to
# override it.
PUBLIC_BRAIN_URL=

# ----- Shared secret: Lexi <-> LexiconServer ----------------------------------
# Leave empty here; set the real value only in the root `.env` or the process
# environment (never commit a real token). ./.tool_token (git-ignored file,
# not this .env) is the standalone fallback when no layer above sets this.
LEXI_TOOL_TOKEN=

# ----- Optional: offload STT to a remote lexi-stt host (used on the Pi) ------
# Empty = transcribe locally with faster-whisper (default). On the Pi this
# would be aragon's address, e.g. http://192.168.1.4:8765 — set that in the
# Pi's own environment/.env; do not invent a value here.
LEXI_STT_REMOTE_URL=

# ----- Optional: per-device Lexicon session for identity ----------------------
# Read directly by lexi/__main__.py (os.environ) — NOT part of the layered
# registry above, and not a destination. A JSESSIONID for this device's
# Lexicon login; unset = falls back to identity.default_account_id.
# LEXICON_SESSION=
